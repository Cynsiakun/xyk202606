<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cd.mapper.BaselineCheckDataMapper">

    <insert id="insert" parameterType="com.cd.entity.BaselineCheckDataEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO baseline_check_data (task_id, host_id, check_data, create_time)
        VALUES (#{taskId}, #{hostId}, #{checkData}, #{createTime})
    </insert>
</mapper>
