<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cd.mapper.VulnRuleMapper">

    <resultMap id="VulnRuleResultMap" type="com.cd.entity.VulnRuleEntity">
        <id column="id" property="id"/>
        <result column="rule_code" property="ruleCode"/>
        <result column="cve_id" property="cveId"/>
        <result column="category" property="category"/>
        <result column="product_type" property="productType"/>
        <result column="product_name" property="productName"/>
        <result column="match_type" property="matchType"/>
        <result column="affected_version_expr" property="affectedVersionExpr"/>
        <result column="severity" property="severity"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="suggestion" property="suggestion"/>
        <result column="verify_type" property="verifyType"/>
        <result column="verify_rule" property="verifyRule"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="baseColumns">
        id, rule_code, cve_id, category, product_type, product_name, match_type,
        affected_version_expr, severity, title, description, suggestion,
        verify_type, verify_rule, enabled, created_at, updated_at
    </sql>

    <sql id="listWhere">
        <where>
            <if test="ruleCode != null and ruleCode != ''">
                AND rule_code LIKE CONCAT('%', #{ruleCode}, '%')
            </if>
            <if test="cveId != null and cveId != ''">
                AND cve_id LIKE CONCAT('%', #{cveId}, '%')
            </if>
            <if test="productName != null and productName != ''">
                AND product_name LIKE CONCAT('%', #{productName}, '%')
            </if>
            <if test="severity != null and severity != ''">
                AND severity = #{severity}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.cd.entity.VulnRuleEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vuln_rule (
            rule_code, cve_id, category, product_type, product_name, match_type,
            affected_version_expr, severity, title, description, suggestion,
            verify_type, verify_rule, enabled
        ) VALUES (
            #{ruleCode}, #{cveId}, #{category}, #{productType}, #{productName}, #{matchType},
            #{affectedVersionExpr}, #{severity}, #{title}, #{description}, #{suggestion},
            #{verifyType}, #{verifyRule}, #{enabled}
        )
    </insert>

    <update id="updateById" parameterType="com.cd.entity.VulnRuleEntity">
        UPDATE vuln_rule
        SET rule_code = #{ruleCode},
            cve_id = #{cveId},
            category = #{category},
            product_type = #{productType},
            product_name = #{productName},
            match_type = #{matchType},
            affected_version_expr = #{affectedVersionExpr},
            severity = #{severity},
            title = #{title},
            description = #{description},
            suggestion = #{suggestion},
            verify_type = #{verifyType},
            verify_rule = #{verifyRule},
            enabled = #{enabled}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM vuln_rule WHERE id = #{id}
    </delete>

    <delete id="deleteBatch">
        DELETE FROM vuln_rule
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectById" resultMap="VulnRuleResultMap">
        SELECT <include refid="baseColumns"/>
        FROM vuln_rule
        WHERE id = #{id}
    </select>

    <select id="selectByRuleCode" resultMap="VulnRuleResultMap">
        SELECT <include refid="baseColumns"/>
        FROM vuln_rule
        WHERE rule_code = #{ruleCode}
        LIMIT 1
    </select>

    <select id="selectPage" resultMap="VulnRuleResultMap">
        SELECT <include refid="baseColumns"/>
        FROM vuln_rule
        <include refid="listWhere"/>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(1)
        FROM vuln_rule
        <include refid="listWhere"/>
    </select>

    <select id="selectEnabledRules" resultMap="VulnRuleResultMap">
        SELECT <include refid="baseColumns"/>
        FROM vuln_rule
        WHERE enabled = 1
        ORDER BY product_type ASC, product_name ASC, id ASC
    </select>
</mapper>
