<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cd.mapper.ProbeStrategyMapper">

    <resultMap id="ProbeStrategyResultMap" type="com.cd.entity.ProbeStrategyEntity">
        <id column="id" property="id"/>
        <result column="enabled" property="enabled"/>
        <result column="period_hours" property="periodHours"/>
        <result column="probe_account" property="probeAccount"/>
        <result column="probe_service" property="probeService"/>
        <result column="probe_process" property="probeProcess"/>
        <result column="probe_app" property="probeApp"/>
        <result column="last_run_at" property="lastRunAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectStrategy" resultMap="ProbeStrategyResultMap">
        SELECT id, enabled, period_hours, probe_account, probe_service,
               probe_process, probe_app, last_run_at, updated_at
        FROM probe_strategy
        WHERE id = 1
    </select>

    <update id="updateStrategy" parameterType="com.cd.entity.ProbeStrategyEntity">
        UPDATE probe_strategy
        SET enabled = #{enabled},
            period_hours = #{periodHours},
            probe_account = #{probeAccount},
            probe_service = #{probeService},
            probe_process = #{probeProcess},
            probe_app = #{probeApp}
        WHERE id = 1
    </update>

    <update id="updateLastRunAt">
        UPDATE probe_strategy
        SET last_run_at = #{lastRunAt}
        WHERE id = 1
    </update>
</mapper>
