<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cd.mapper.MqErrorLogMapper">

    <insert id="insert" parameterType="com.cd.entity.MqErrorLogEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mq_error_logs (queue_name, raw_message, error_reason)
        VALUES (#{queueName}, #{rawMessage}, #{errorReason})
    </insert>
</mapper>
